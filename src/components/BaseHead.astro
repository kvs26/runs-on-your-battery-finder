---
/**
 * BaseHead.astro — every <head> tag the SEO baseline needs (research/03).
 * Canonical, OG (all required + image dims), Twitter, JSON-LD @graph,
 * font preload, and the single analytics insertion point (ticket 04).
 */
import { SITE, absUrl } from '../lib/site.config.mjs';
import { pageTitle, graph } from '../lib/seo.mjs';

interface Props {
  title?: string;
  description?: string;
  /** Root-relative path for the canonical/OG URL. Defaults to current page. */
  path?: string;
  /** Root-relative OG image path. Defaults to SITE.ogImage. */
  ogImage?: string;
  ogImageAlt?: string;
  /** schema.org nodes to emit in a single @graph. */
  jsonLdNodes?: unknown[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.tagline,
  path = Astro.url.pathname,
  ogImage = SITE.ogImage,
  ogImageAlt = SITE.name,
  jsonLdNodes = [],
  noindex = false,
} = Astro.props;

const fullTitle = pageTitle(title);
const canonical = absUrl(path);
const ogImageUrl = absUrl(ogImage);
const ld = jsonLdNodes.length ? graph(jsonLdNodes) : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- OpenGraph (ogp.me required: title/type/image/url) -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={title ?? SITE.name} />
<meta property="og:type" content="website" />
<meta property="og:url" content={canonical} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />

<!-- Twitter card mirrors OG -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title ?? SITE.name} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Icons (one SVG master; drop real assets into /public) -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Brand font: preload the single body woff2 (font-display:optional => no CLS) -->
<link
  rel="preload"
  href="/fonts/brand.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>

{ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}

<!-- ===== Analytics single insertion point (ticket 04) ===== -->
{SITE.analytics.provider === 'cloudflare' && SITE.analytics.token && (
  <script
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={`{"token": "${SITE.analytics.token}"}`}
  />
)}
{SITE.analytics.provider === 'plausible' && SITE.analytics.token && (
  <script defer data-domain={SITE.analytics.token} src="https://plausible.io/js/script.js"></script>
)}
