---
/**
 * AdSlot.astro — a reserved-space ad hole (ticket 04).
 * When SITE.monetization.ads is enabled (and a publisher id is set) it renders
 * the live AdSense ins tag. When ads are OFF it renders a labelled placeholder
 * ONLY during local development (`npm run dev`) so we can design against the
 * reserved space — in a production build it renders nothing, so real visitors
 * never see "reserved" boxes.
 */
import { SITE } from '../lib/site.config.mjs';

interface Props {
  /** 'rectangle' (300x250) | 'leaderboard' (728x90) | 'inarticle'. */
  format?: 'rectangle' | 'leaderboard' | 'inarticle';
  /** AdSense ad unit slot id (data-ad-slot). Only used when ads are enabled. */
  slot?: string;
  label?: string;
}

const { format = 'rectangle', slot = '', label } = Astro.props;
const ads = SITE.monetization.ads;
const live = ads.enabled && ads.adsensePublisherId;
/** Show the grey placeholder only while developing locally, never in prod. */
const showPlaceholder = !live && import.meta.env.DEV;
---
{live ? (
  <aside class="ad-slot ad-slot--live" data-format={format} aria-label="Advertisement">
    <span class="visually-hidden">Advertisement</span>
    <ins
      class="adsbygoogle"
      style="display:block;width:100%"
      data-ad-client={ads.adsensePublisherId}
      data-ad-slot={slot}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  </aside>
) : showPlaceholder ? (
  <aside class="ad-slot" data-format={format} aria-hidden="true">
    <span class="ad-label">{label ?? `Ad slot · ${format} · reserved`}</span>
  </aside>
) : null}
