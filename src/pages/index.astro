---
/**
 * index.astro — HOME + interactive tool page (app-shell base, dir 08).
 * All products are server-rendered (crawlable, SEO) inside the results pane;
 * the vanilla-JS island filters them client-side (show/hide) — the only client
 * JS in production (ticket 08). Layout mode (list vs grid) follows SITE.layoutMode.
 */
import Layout from '../layouts/Layout.astro';
import AdSlot from '../components/AdSlot.astro';
import AffiliateLink from '../components/AffiliateLink.astro';
import { SITE } from '../lib/site.config.mjs';
import { platforms, categories, products, FIT, platformBySlug, categoryBySlug } from '../lib/catalog.mjs';
import {
  organizationLd,
  websiteLd,
  webApplicationLd,
  itemListLd,
} from '../lib/seo.mjs';

const mode = SITE.layoutMode === 'grid' ? 'grid' : 'list';
/**
 * Ad regions are shown when ads are live (approved + publisher id set) OR while
 * developing locally, so we can design against the reserved slots. In a
 * production build with ads still off we drop the ad rail entirely and let the
 * results pane use the full width — no empty column, no placeholder boxes.
 */
const adsLive = SITE.monetization.ads.enabled && SITE.monetization.ads.adsensePublisherId;
const showAdRegions = adsLive || import.meta.env.DEV;
const description =
  'Pick your battery and a gadget type to see everything that runs on the battery you already own — each one marked made for it, fits as-is, or needs an adapter, and checked by hand.';
const coverageNames = platforms.map((p) => p.name).join(', ');

const jsonLdNodes = [
  organizationLd(),
  websiteLd(),
  webApplicationLd({
    name: `${SITE.name} Finder`,
    description,
    url: '/',
  }),
  itemListLd(products.map((p) => ({ url: `/${p.platform}/${p.category}`, name: p.name }))),
];
---
<Layout title={null} description={description} jsonLdNodes={jsonLdNodes}>
  <section class="hero hero--home container">
    <h1>What runs on your battery?</h1>
    <p class="lead">Pick your battery and the kind of gadget you want. See what runs on the battery you already own — and whether it clicks straight on or needs an adapter.</p>
  </section>

  <form class={`app-shell container${showAdRegions ? '' : ' app-shell--noads'}`} aria-label="Compatibility finder">
    <!-- FILTER RAIL (borderless — no box, no grey) -->
    <aside class="rail">
      <p class="rail-title">Filters</p>
      <div class="field">
        <label for="f-platform">Your battery</label>
        <select id="f-platform" name="platform" data-filter="platform">
          <option value="">All batteries</option>
          {platforms.map((p) => <option value={p.slug}>{p.name}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="f-category">Gadget type</label>
        <select id="f-category" name="category" data-filter="category">
          <option value="">All gadgets</option>
          {categories.map((c) => <option value={c.slug}>{c.name}</option>)}
        </select>
      </div>
      <fieldset class="field">
        <span class="legend">
          Fit
          <button class="info" type="button" aria-label="What the fit labels mean">
            i
            <span class="tip" role="tooltip">
              <strong>Made for it</strong> — same brand as your battery.<br />
              <strong>Fits as-is</strong> — another brand, clicks on with no adapter.<br />
              <strong>Needs adapter</strong> — works only with a separate adapter part.
            </span>
          </button>
        </span>
        <div class="fit-toggles">
          <label class="choice"><input type="checkbox" name="fit" value="native" data-filter="fit" /> Made for it</label>
          <label class="choice"><input type="checkbox" name="fit" value="direct" data-filter="fit" /> Fits as-is</label>
          <label class="choice"><input type="checkbox" name="fit" value="adapter" data-filter="fit" /> Needs adapter</label>
        </div>
      </fieldset>

      {showAdRegions && (
        <AdSlot format="rectangle" label="Ad slot · reserved" />
      )}
    </aside>

    <!-- RESULTS PANE -->
    <div class={`results-pane results--${mode}`}>
      <div class="results-head">
        <h2 class="visually-hidden">Results</h2>
        <p class="result-count" aria-live="polite"><strong data-count>{products.length}</strong> gadgets</p>
      </div>

      <div id="result-list">
        {products.map((p) => {
          const fit = FIT[p.fit] ?? { label: p.fit, badge: '' };
          const platformName = platformBySlug(p.platform)?.name ?? p.platform;
          const categoryName = categoryBySlug(p.category)?.name ?? p.category;
          return (
            <article class="result" data-platform={p.platform} data-category={p.category} data-fit={p.fit}>
              {mode === 'grid' && <div class="thumb" aria-hidden="true">image</div>}
              <div>
                <p class="result-tags">
                  <span class="chip">{platformName}</span>
                  <span class="chip chip--muted">{categoryName}</span>
                </p>
                <h3 class="result-title"><AffiliateLink label={p.name} affiliate={p.affiliate} /></h3>
                <p class="result-meta">{p.note}</p>
              </div>
              <span class={`badge ${fit.badge}`}>{fit.label}</span>
            </article>
          );
        })}
      </div>

      <p class="empty-state" data-empty hidden>No matches yet. Try clearing a filter.</p>

      <nav class="pagination" data-pagination hidden aria-label="Results pages"></nav>
    </div>

    {showAdRegions && (
      <aside class="ad-rail" aria-label="Advertisements">
        <AdSlot format="rectangle" label="Ad slot · reserved" />
        <AdSlot format="rectangle" label="Ad slot · reserved" />
      </aside>
    )}
  </form>
</Layout>

<script>
  // Vanilla-JS filter + pagination island (ticket 08). Server-rendered results
  // stay crawlable; JS shows one page at a time and rebuilds the pager.
  const shell = document.querySelector('.app-shell');
  if (shell) {
    const PER_PAGE = 8;
    const items = Array.from(shell.querySelectorAll('.result'));
    const countEl = shell.querySelector('[data-count]');
    const emptyEl = shell.querySelector('[data-empty]');
    const pager = shell.querySelector('[data-pagination]');
    let filtered = items.slice();
    let page = 1;

    function applyFilters() {
      const platform = shell.querySelector('[data-filter="platform"]').value;
      const category = shell.querySelector('[data-filter="category"]').value;
      const fits = Array.from(shell.querySelectorAll('[data-filter="fit"]:checked')).map((el) => el.value);
      filtered = items.filter((el) =>
        (!platform || el.dataset.platform === platform) &&
        (!category || el.dataset.category === category) &&
        (fits.length === 0 || fits.includes(el.dataset.fit))
      );
      page = 1;
      render();
    }

    function render() {
      const total = filtered.length;
      const pages = Math.max(1, Math.ceil(total / PER_PAGE));
      if (page > pages) page = pages;
      const start = (page - 1) * PER_PAGE;
      for (const el of items) el.hidden = true;
      filtered.slice(start, start + PER_PAGE).forEach((el) => { el.hidden = false; });
      if (countEl) countEl.textContent = String(total);
      if (emptyEl) emptyEl.hidden = total !== 0;
      renderPager(pages);
    }

    function renderPager(pages) {
      if (!pager) return;
      pager.replaceChildren();
      if (pages <= 1) { pager.hidden = true; return; }
      pager.hidden = false;
      const go = (target) => { page = target; render(); shell.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
      const mk = (text, target, opts = {}) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'page-btn';
        b.textContent = text;
        if (opts.current) b.setAttribute('aria-current', 'true');
        if (opts.disabled) b.disabled = true;
        if (opts.aria) b.setAttribute('aria-label', opts.aria);
        if (!opts.disabled) b.addEventListener('click', () => go(target));
        return b;
      };
      pager.appendChild(mk('‹', page - 1, { disabled: page === 1, aria: 'Previous page' }));
      const nums = [];
      for (let i = 1; i <= pages; i++) {
        if (i === 1 || i === pages || Math.abs(i - page) <= 1) nums.push(i);
        else if (nums[nums.length - 1] !== '…') nums.push('…');
      }
      for (const n of nums) {
        if (n === '…') {
          const s = document.createElement('span');
          s.className = 'page-ellipsis';
          s.textContent = '…';
          pager.appendChild(s);
        } else {
          pager.appendChild(mk(String(n), n, { current: n === page, aria: `Page ${n}` }));
        }
      }
      pager.appendChild(mk('›', page + 1, { disabled: page === pages, aria: 'Next page' }));
    }

    shell.addEventListener('change', applyFilters);
    shell.addEventListener('submit', (e) => e.preventDefault());
    render();
  }
</script>
