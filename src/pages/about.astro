---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site.config.mjs';
import { organizationLd, breadcrumbLd } from '../lib/seo.mjs';
const title = 'About';
const description = `Who runs ${SITE.name} and why it exists.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: title }];
---
<Layout title={title} description={description} jsonLdNodes={[organizationLd(), breadcrumbLd(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <article class="container prose" style="padding-block:var(--space-12)">
    <h1>About {SITE.name}</h1>
    <p>{SITE.name} is an independent reference that answers one narrow question well: what gadgets run
      on a given power-tool battery platform. Every entry is researched and hand-verified — see the
      <a href="/methodology">methodology</a>.</p>
    <h2>Why this exists</h2>
    <p>Compatibility information is scattered across manufacturer pages and forums. This site pulls it
      into one filterable place so you can decide before you buy.</p>
    <h2>Editorial independence</h2>
    <p>Rankings and flags are based on verified compatibility, never on commercial relationships. Where
      links earn a commission, that is disclosed on the <a href="/disclosure">affiliate disclosure</a>
      page.</p>
    <h2>Contact</h2>
    <p>Corrections and questions: <a href="/contact">get in touch</a>.</p>
  </article>
</Layout>
