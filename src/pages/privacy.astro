---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site.config.mjs';
import { organizationLd, breadcrumbLd } from '../lib/seo.mjs';
const title = 'Privacy policy';
const description = `How ${SITE.name} handles data, cookies, and analytics.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: title }];
// Privacy is the one AdSense-documented required page (research/09 §4, ticket 04).
---
<Layout title={title} description={description} jsonLdNodes={[organizationLd(), breadcrumbLd(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <article class="container prose" style="padding-block:var(--space-12)">
    <h1>Privacy policy</h1>
    <p class="muted">Last updated: {new Date().getFullYear()}. This is a starter policy — review with
      the specifics of your analytics/ads setup before launch.</p>

    <h2>What we collect</h2>
    <p>{SITE.name} is a static site. We do not run accounts or a database and do not collect personal
      information you don't send us (e.g. by email).</p>

    <h2>Analytics</h2>
    <p>We use privacy-friendly, aggregate analytics to understand traffic. When configured with a
      cookieless provider (such as Cloudflare Web Analytics), no cookies are set and no personal data
      is collected.</p>

    <h2>Advertising cookies</h2>
    <p>If advertising is enabled, third-party vendors including Google may use cookies to serve ads
      based on prior visits. Google's use of advertising cookies enables it and its partners to serve
      ads to you based on your visits to this and other sites. You may opt out of personalized
      advertising via <a href="https://www.google.com/settings/ads" rel="nofollow">Google Ads
      Settings</a>.</p>

    <h2>Affiliate links</h2>
    <p>Some outbound links may be affiliate links; see the <a href="/disclosure">affiliate
      disclosure</a>.</p>

    <h2>Contact</h2>
    <p>Questions about privacy? <a href="/contact">Contact us</a>.</p>
  </article>
</Layout>
