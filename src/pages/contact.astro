---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../lib/site.config.mjs';
import { organizationLd, breadcrumbLd } from '../lib/seo.mjs';
const title = 'Contact';
const description = `How to reach ${SITE.name} with corrections, questions, or feedback.`;
const crumbs = [{ name: 'Home', href: '/' }, { name: title }];
---
<Layout title={title} description={description} jsonLdNodes={[organizationLd(), breadcrumbLd(crumbs)]}>
  <Breadcrumbs items={crumbs} />
  <article class="container prose" style="padding-block:var(--space-12)">
    <h1>Contact</h1>
    <p class="lead">Email is the best way to reach us. We read every message, and corrections to the
      compatibility data jump the queue.</p>

    <p><a class="btn btn--primary" href="mailto:hello@example.com">Email us</a></p>
    <p class="muted">Address to set before launch: replace <code>hello@example.com</code> in
      <code>src/pages/contact.astro</code>.</p>

    <h2>Spotted something wrong?</h2>
    <p>If a gadget is listed under the wrong battery, marked with the wrong fit, or is missing entirely,
      tell us. Fixing the data is the whole point of the site, so these get looked at first.</p>

    <h2>What to include</h2>
    <ul>
      <li>The battery brand and the gadget name (a link to the product page helps a lot).</li>
      <li>Whether it should be <strong>Made for it</strong>, <strong>Fits as-is</strong>, or
        <strong>Needs adapter</strong> — and how you know.</li>
      <li>If it needs an adapter, which adapter you used.</li>
    </ul>

    <h2>What to expect</h2>
    <p>We aim to reply within a few days. Straightforward data fixes are usually made quietly without a
      reply — check back and the entry should be updated.</p>

    <h2>Everything else</h2>
    <p>Questions about how entries are graded are answered on the
      <a href="/methodology">How we check</a> page. Commercial links are covered in the
      <a href="/disclosure">affiliate disclosure</a>.</p>
  </article>
</Layout>
